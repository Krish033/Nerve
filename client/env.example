# Client Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ============================================
# Firebase Configuration (Required)
# ============================================
# Get these from your Firebase Console: https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_for_push_notifications

# ============================================
# Cloudflare Turnstile (Optional)
# ============================================
# Used for bot protection on forms
# Get from: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_CF_TURNSTILE_SITE_KEY=0x00000000000000000000AA

# ============================================
# API Configuration
# ============================================
# Backend API URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ============================================
# Feature Flags (Optional)
# ============================================
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=true
NEXT_PUBLIC_APP_ENV=development

# ============================================
# Note: Server-side environment variables
# ============================================
# These are handled by the gateway service
# Do not add server secrets here - they won't be secure in the browser
# Server secrets belong in the gateway/.env file only
