# ============================================
# NURVE MARKETPLACE MICROSERVICE
# Environment Configuration
# ============================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nurve_marketplace?schema=public"

# Redis (Required for production queue and event infrastructure)
# Set USE_REDIS=true to enable Redis-backed QueueService and EventBus
USE_REDIS=false
REDIS_URL="redis://localhost:6379"

# Optional: Separate Redis for pub/sub (if using different Redis instance)
# REDIS_PUBSUB_URL="redis://localhost:6379"

# Server
PORT=3002
NODE_ENV=development

# Module Discovery
# Path to modules directory (defaults to ./src/modules)
# MODULES_DIR=/app/modules

# Security
JWT_SECRET=your-secret-key-change-in-production
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Feature Flags
ENABLE_WORKFLOWS=true
ENABLE_WIDGETS=true

# Queue Configuration
QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=3

# Event Bus Configuration
EVENT_BUS_MAX_QUEUE_SIZE=1000
EVENT_BUS_TIMEOUT=30000
