// This is a generated file, do not edit.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String    @id @default(uuid())
  firebaseUid    String    @unique
  email          String    @unique
  name           String
  mobile         String?
  profilePicture String?
  refreshToken   String?   
  isTwoFactorEnabled Boolean @default(false)
  twoFactorSecret    String?
  twoFactorType      String?   
  isEmailVerified    Boolean   @default(false)
  isMobileVerified   Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLogin      DateTime?
  fcmToken       String?
  
  blogs          Blog[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  sessions       Session[]
  installedItems UserInstalledItem[]
  tenantUsers    TenantUser[]

  @@index([email])
  @@index([firebaseUid])
  @@index([createdAt])
  @@map("users")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("INFO") 
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String   
  details   String?
  ip        String?
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([module, action])
  @@map("activity_logs")
}

model ErrorLog {
  id        String   @id @default(uuid())
  type      String
  message   String
  stack     String?  @db.Text
  node      String   @default("GATEWAY")
  severity  String   @default("ERROR") 
  createdAt DateTime @default(now())

  @@map("error_logs")
}

model AccessLog {
  id        String   @id @default(uuid())
  path      String
  method    String
  status    Int
  latency   Int      
  ip        String?
  userId    String?
  createdAt DateTime @default(now())

  @@map("access_logs")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  device    String
  os        String
  browser   String
  ip        String
  location  String?
  lastActive DateTime @default(now())
  token     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([isActive])
  @@map("sessions")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  group     String?  
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Blog {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  content        String   @db.Text
  excerpt        String?  @db.Text
  coverImage     String?
  authorId       String
  author         User     @relation(fields: [authorId], references: [id])
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([authorId])
  @@index([published])
  @@index([createdAt])
  @@map("blogs")
}

model AdBanner {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String
  link      String
  placement String   
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ad_banners")
}

model MarketplaceItem {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("THEME") // e.g. THEME, PLUGIN
  description String?  @db.Text
  assets      Json?    // e.g., URLs to font files, images
  config      Json?    // Specific configuration data (colors, styles)
  price       Float    @default(0)
  author      String   @default("System")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  installedBy UserInstalledItem[]
  
  @@unique([name, type])
  @@index([type, isActive])
  @@index([createdAt])
  @@map("marketplace_items")
}

model UserInstalledItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  itemId    String
  item      MarketplaceItem @relation(fields: [itemId], references: [id])
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
  @@index([userId, isActive])
  @@map("user_installed_items")
}

// ============================================
// PLATFORM MODULE SYSTEM
// ============================================

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  plan        String   @default("free") // free, basic, pro, enterprise
  status      String   @default("active") // active, suspended, deleted
  config      Json?    // Tenant-specific configuration
  features    String[] // Enabled feature flags
  settings    Json?    // Tenant settings
  metadata    Json?    // Additional metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  users       TenantUser[]
  modules     TenantModule[]
  jobs        Job[]
  auditLogs   AuditLog[]
  
  @@index([slug])
  @@index([status])
  @@index([plan])
  @@map("tenants")
}

model TenantUser {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("member") // owner, admin, member, viewer
  permissions String[] // Direct permissions
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  lastAccessedAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_users")
}

model PlatformModule {
  id          String   @id @default(uuid())
  moduleId    String   @unique // e.g., "dashboard", "scraper"
  name        String
  version     String   @default("1.0.0")
  description String?
  author      String?
  icon        String?
  status      String   @default("active") // active, disabled, deprecated
  manifest    Json     // Full manifest.json content
  settingsSchema Json?  // JSON schema for settings validation
  defaultSettings Json? // Default settings values
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantModules TenantModule[]
  
  @@index([moduleId])
  @@index([status])
  @@map("platform_modules")
}

model TenantModule {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  moduleId    String
  module      PlatformModule @relation(fields: [moduleId], references: [id])
  isEnabled   Boolean  @default(true)
  settings    Json?    // Tenant-specific module settings
  config      Json?    // Runtime configuration
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@index([moduleId])
  @@map("tenant_modules")
}

model Permission {
  id          String   @id @default(uuid())
  permissionId String  @unique // e.g., "scraper.run", "dashboard.view"
  name        String
  description String?
  moduleId    String?  // Associated module
  category    String   @default("general") // general, module, system
  scope       String   @default("tenant") // tenant, global, user
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  roles       RolePermission[]
  
  @@index([moduleId])
  @@index([category])
  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid())
  roleId      String   @unique // e.g., "admin", "editor"
  name        String
  description String?
  tenantId    String?  // null = global role
  isSystem    Boolean  @default(false)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Job {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  queue       String   // e.g., "scraper", "processor", "default"
  data        Json     // Job payload
  status      String   @default("pending") // pending, active, completed, failed, delayed
  progress    Int      @default(0) // 0-100
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  error       String?  @db.Text
  result      Json?    // Job result data
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  scheduledAt DateTime? // For delayed jobs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs        JobLog[]
  
  @@index([tenantId])
  @@index([queue, status])
  @@index([status, scheduledAt])
  @@index([createdAt])
  @@map("jobs")
}

model JobLog {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  level     String   // info, warn, error, debug
  message   String
  metadata  Json?    // Additional context
  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([createdAt])
  @@map("job_logs")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  userId      String?
  action      String   // e.g., "module.installed", "job.created"
  resource    String   // e.g., "module:scraper", "job:123"
  details     Json?    // Additional context
  ip          String?
  userAgent   String?
  severity    String   @default("info") // info, warning, critical
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String   // e.g., "kernel.ready", "module.registered"
  moduleId    String?  // Source module
  tenantId    String?  // Target tenant (if applicable)
  payload     Json?    // Event data
  metadata    Json?    // Event metadata (correlationId, timestamp, etc.)
  processed   Boolean  @default(false)
  processedAt DateTime?
  error       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([moduleId])
  @@index([tenantId])
  @@index([processed])
  @@index([createdAt])
  @@map("system_events")
}

model Workflow {
  id          String   @id @default(uuid())
  tenantId    String?
  name        String
  description String?
  trigger     String   // Event that triggers this workflow
  conditions  Json?    // Conditions for execution
  actions     Json     // Actions to execute
  isActive    Boolean  @default(true)
  executionCount Int    @default(0)
  lastExecutedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions  WorkflowExecution[]
  
  @@index([tenantId])
  @@index([trigger])
  @@index([isActive])
  @@map("workflows")
}

model WorkflowExecution {
  id          String   @id @default(uuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id])
  tenantId    String?
  triggerData Json?    // Data that triggered the workflow
  context     Json?    // Execution context
  status      String   @default("pending") // pending, running, completed, failed, cancelled
  results     Json?    // Action results
  error       String?  @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([workflowId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("workflow_executions")
}

model Widget {
  id          String   @id @default(uuid())
  widgetId    String   @unique // e.g., "recent-activity", "stats-card"
  moduleId    String   // Source module
  name        String
  description String?
  component   String   // Component identifier
  category    String   @default("dashboard") // dashboard, sidebar, modal
  defaultConfig Json? // Default configuration
  permissions String[] // Required permissions
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instances   WidgetInstance[]
  
  @@index([moduleId])
  @@index([category])
  @@map("widgets")
}

model WidgetInstance {
  id          String   @id @default(uuid())
  widgetId    String
  widget      Widget   @relation(fields: [widgetId], references: [id])
  tenantId    String
  userId      String?  // null = available to all users in tenant
  dashboardId String?  // e.g., "main", "analytics"
  config      Json?    // Instance-specific configuration
  position    Int      @default(0) // Display order
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([dashboardId])
  @@map("widget_instances")
}

// ============================================
// PLUGIN SYSTEM
// ============================================

model Plugin {
  id          String   @id @default(uuid())
  name        String   @unique
  version     String
  type        String   // api-plugin, ui-plugin, workflow-plugin, etc.
  manifest    String   @db.Text // JSON string of full manifest
  state       String   // INSTALLED, ENABLED, DISABLED, FAILED, BROKEN
  installPath String
  enabledAt   DateTime?
  healthStatus String?  // healthy, degraded, unhealthy, unknown
  failureCount Int     @default(0)
  lastFailure String?  @db.Text // JSON string
  stateHistory String? @db.Text // JSON array
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([state])
  @@index([type])
  @@index([installedAt])
  @@map("plugins")
}
